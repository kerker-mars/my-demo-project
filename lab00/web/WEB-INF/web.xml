<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
<!--    servlet地址-->
    <servlet>
        <servlet-name>newServletDemo</servlet-name>
        <servlet-class>com.servlet.newServletDemo</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>newServletDemo</servlet-name>
        <url-pattern>/newServletDemo</url-pattern>
    </servlet-mapping>



<!--    登录servlet-->
    <servlet>
        <servlet-name>newServletLogin</servlet-name>
        <servlet-class>com.servlet.newServletLogin</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>newServletLogin</servlet-name>
        <url-pattern>/newServletLogin</url-pattern>
    </servlet-mapping>


    <!--    学生基础信息维护-->

    <servlet>
        <servlet-name>ServletStudent</servlet-name>
        <servlet-class>com.servlet.ServletStudent</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServletStudent</servlet-name>
        <url-pattern>/ServletStudent</url-pattern>
    </servlet-mapping>


    <!--    毕业信息维护   -->
    <servlet>
        <servlet-name>ServletEmploymentInfo</servlet-name>
        <servlet-class>com.servlet.ServletEmploymentInfo</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServletEmploymentInfo</servlet-name>
        <url-pattern>/ServletEmploymentInfo</url-pattern>
    </servlet-mapping>

    <!--    耗材基础信息维护-->
    <servlet>
        <servlet-name>ServletConsumable</servlet-name>
        <servlet-class>com.servlet.ServletConsumable</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServletConsumable</servlet-name>
        <url-pattern>/ServletConsumable</url-pattern>
    </servlet-mapping>

    <!--    领用申请/审核/出库-->
    <servlet>
        <servlet-name>ServletOutbound</servlet-name>
        <servlet-class>com.servlet.ServletOutbound</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServletOutbound</servlet-name>
        <url-pattern>/ServletOutbound</url-pattern>
    </servlet-mapping>

 <!-- 耗材统计分析 -->
    <servlet>
        <servlet-name>ReportServlet</servlet-name>
        <servlet-class>com.servlet.ReportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReportServlet</servlet-name>
        <url-pattern>/ReportServlet</url-pattern>
    </servlet-mapping>
    <!-- 采购计划 -->
    <servlet>
        <servlet-name>ServletPurchasePlan</servlet-name>
        <servlet-class>com.servlet.ServletPurchasePlan</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServletPurchasePlan</servlet-name>
        <url-pattern>/ServletPurchasePlan</url-pattern>
    </servlet-mapping>

    <!-- 入库登记 -->
    <servlet>
        <servlet-name>ServletInbound</servlet-name>
        <servlet-class>com.servlet.ServletInbound</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServletInbound</servlet-name>
        <url-pattern>/ServletInbound</url-pattern>
    </servlet-mapping>
    
    <!--    数据库连接池配置   -->
    <resource-ref>
        <description>MySQL Datasource</description>
        <res-ref-name>jdbc/graduate_system</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
    </resource-ref>

    <!-- 归还登记 -->
    <servlet>
        <servlet-name>ServletReturn</servlet-name>
        <servlet-class>com.servlet.ServletReturn</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServletReturn</servlet-name>
        <url-pattern>/ServletReturn</url-pattern>
    </servlet-mapping>

    <!-- 报废登记 -->
    <servlet>
        <servlet-name>ServletScrap</servlet-name>
        <servlet-class>com.servlet.ServletScrap</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServletScrap</servlet-name>
        <url-pattern>/ServletScrap</url-pattern>
    </servlet-mapping>

    <!-- 教师：使用反馈 -->
    <servlet>
        <servlet-name>ServletUsageFeedback</servlet-name>
        <servlet-class>com.servlet.ServletUsageFeedback</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServletUsageFeedback</servlet-name>
        <url-pattern>/ServletUsageFeedback</url-pattern>
    </servlet-mapping>

    <!-- 系统管理员：用户管理 -->
    <servlet>
        <servlet-name>ServletSysUser</servlet-name>
        <servlet-class>com.servlet.ServletSysUser</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServletSysUser</servlet-name>
        <url-pattern>/ServletSysUser</url-pattern>
    </servlet-mapping>

    <!-- 系统管理员：角色配置 -->
    <servlet>
        <servlet-name>ServletSysRole</servlet-name>
        <servlet-class>com.servlet.ServletSysRole</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServletSysRole</servlet-name>
        <url-pattern>/ServletSysRole</url-pattern>
    </servlet-mapping>

    <!-- 库存盘点（实验室管理员） -->
    <servlet>
        <servlet-name>ServletInventory</servlet-name>
        <servlet-class>com.servlet.ServletInventory</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServletInventory</servlet-name>
        <url-pattern>/ServletInventory</url-pattern>
    </servlet-mapping>

</web-app>